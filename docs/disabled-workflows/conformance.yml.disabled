name: conformance
on: [push, pull_request, workflow_dispatch]
permissions:
  contents: read
jobs:
  offline:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1, resolved 2026-11-23
        with:
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0, resolved 2026-11-23
        with:
          python-version: '3.13'
      - name: Validate independent corpus and package
        env:
          PYTHONDONTWRITEBYTECODE: '1'
        run: python tools/verify.py --output local-results/tests.json
      - name: Run packaged CLI
        run: python -I dist/agent-permission-clinic.pyz --output local-results/permission-report.json
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2, resolved 2026-11-23
        with:
          name: clinic-${{ matrix.os }}-${{ github.sha }}
          path: |
            dist/agent-permission-clinic.pyz
            local-results/permission-report.json
            local-results/tests.json
          if-no-files-found: error
  downloaded:
    needs: offline
    permissions:
      contents: read
      actions: read
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: '3.13'
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2, resolved 2026-11-23
        with:
          name: clinic-${{ matrix.os }}-${{ github.sha }}
          path: local-results/downloaded
          github-token: ${{ github.token }}
          run-id: ${{ github.run_id }}
          repository: ${{ github.repository }}
          digest-mismatch: error
      - name: Execute downloaded artifact from isolated mode
        run: python -I local-results/downloaded/dist/agent-permission-clinic.pyz --output local-results/downloaded-report.json
      - name: Verify downloaded report equals source report
        run: python -c "import json,pathlib; a=json.loads(pathlib.Path('local-results/downloaded/local-results/permission-report.json').read_text()); b=json.loads(pathlib.Path('local-results/downloaded-report.json').read_text()); assert a == b"
